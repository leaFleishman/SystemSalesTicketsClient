# Only needed if you are NOT using the Vite dev proxy (see vite.config.js).
# Leave unset during normal `npm run dev` usage.
# VITE_API_BASE=https://your-deployed-api.example.com/api

# Where the dev proxy forwards /api and /health to. Defaults to the
# backend's "http" launch profile (http://localhost:5153). Switch to
# https://localhost:7171 if you run the "https" profile instead.
# VITE_API_PROXY_TARGET=http://localhost:5153
